Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical URL: HTTPS on the non-www domain.
  # Apache preserves the original path and query string automatically.
  RewriteCond %{HTTP_HOST} ^(?:www\.)?piraty\.in$ [NC]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.piraty\.in$ [NC]
  RewriteRule ^ https://piraty.in%{REQUEST_URI} [R=301,L,NE]

  RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK|CONNECT)$ [NC]
  RewriteRule ^ - [F,L]

  RewriteCond %{HTTP_USER_AGENT} "(curl|wget|python-requests|scrapy|httpclient|libwww-perl|go-http-client|masscan|sqlmap|nikto|nmap|headlesschrome|bytespider|petalbot|semrushbot|ahrefsbot|mj12bot|dotbot)" [NC]
  RewriteRule ^ - [F,L]

  RewriteCond %{THE_REQUEST} "\s/+(\.git|\.env|composer\.(json|lock)|package-lock\.json|INSTALLATION_SUMMARY\.txt|PLAYER_[^?\s]*|README[^?\s]*)" [NC]
  RewriteRule ^ - [F,L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>

  <FilesMatch "(cache-version\.js|manifest\.json)$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(css|js|mjs|png|jpg|jpeg|gif|webp|avif|svg|ico|woff|woff2)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<FilesMatch "^(\.env|\.gitignore|composer\.(json|lock)|package-lock\.json)$">
  Require all denied
</FilesMatch>
