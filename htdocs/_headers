# Cloudflare Pages Custom Headers
# Ref: https://developers.cloudflare.com/pages/configuration/headers/

# HTML documents: always fetch latest version on revisit
/*.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Cache-busting script & manifest
/assets/js/cache-version.js
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/manifest.json
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

# Static immutable assets (styles, scripts, images, fonts)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

